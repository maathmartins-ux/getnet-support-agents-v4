# Copie para .env (nunca commitado). Sem chave, o sistema roda no modo offline determinístico.
LLM_PROVIDER=offline
# No PC: ANTHROPIC_API_KEY. Na NUVEM (claude.ai/code): APP_ANTHROPIC_API_KEY nas variáveis do ambiente, porque
# lá ANTHROPIC_API_KEY é reservada ao Claude Code. O app aceita as duas (config.llm_api_key).
ANTHROPIC_API_KEY=

# Identidade: required (padrão, só Bearer) | demo (aceita user_id do corpo, ver docs/adr/0001)
AUTH_MODE=required
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
OPERATOR_TOKEN=troque-por-outro-segredo-longo
# APP_ENV=production recusa subir com segredo padrão

# Modelos e effort por papel (padrões no config.ROLES). Ex.: SUPERVISOR_EFFORT=low
# ROUTER_MODEL=claude-haiku-5-5
# SUPERVISOR_MODEL=claude-sonnet-5-5
# AGENT_MODEL=claude-sonnet-5-5
# JUDGE_MODEL=claude-opus-5-5
# SUPERVISOR_PARALLEL=true

# Busca: bm25 (padrão) | hybrid (pip install -e ".[hybrid]"; mede com --compare-retrievers)
RETRIEVER=bm25
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# OpenTelemetry opcional: console | otlp (pip install -e ".[otel]"; OTEL_EXPORTER_OTLP_ENDPOINT=...)
# OTEL_EXPORTER=console

# Telegram opcional (aviso de novo caso + resposta do operador pelo chat)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
